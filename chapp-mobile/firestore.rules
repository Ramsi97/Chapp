rules_version = '2';

// Security rules for Chapp.
//
// Model:
//   users/{uid}                     – profile (owner-writable, world-readable to signed-in users)
//   chats/{chatId}                  – conversation doc (members only)
//   chats/{chatId}/messages/{msgId} – messages (members read, sender creates)
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ---------------- Users ----------------
    match /users/{userId} {
      // Any signed-in user can read profiles: needed for user search,
      // presence dots, and chat headers.
      allow read: if isSignedIn();

      // A user may only create/update their own profile document.
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // ---------------- Chats ----------------
    match /chats/{chatId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      function willBeParticipant() {
        return isSignedIn() &&
               request.auth.uid in request.resource.data.participants;
      }

      // Only members can read a chat. This also satisfies the chat-list query
      // `where('participants', arrayContains: myUid)`.
      allow read: if isParticipant();

      // The creator must include themselves in participants.
      allow create: if willBeParticipant() &&
                       request.resource.data.createdBy == request.auth.uid;

      // Members may update lastMessage / unreadCounts / typing / lastRead.
      allow update: if isParticipant();
      allow delete: if false;

      // ---------------- Messages ----------------
      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function isChatMember() {
          return isSignedIn() &&
                 request.auth.uid in parentChat().participants;
        }

        allow read: if isChatMember();

        // Only a chat member may send, and only as themselves.
        allow create: if isChatMember() &&
                         request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
