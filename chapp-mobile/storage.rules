rules_version = '2';

// Storage rules for Chapp.
//
// Paths:
//   profilePics/{uid}.jpg          – avatars (owner writes, signed-in reads)
//   groupPics/{chatId}.jpg         – group photos
//   chatMedia/{chatId}/{msgId}.jpg – image messages
//
// NOTE: Storage rules cannot query Firestore, so chat-membership can't be
// enforced here. Group/chat media is therefore limited to signed-in users.
// Tighten with custom claims or a Cloud Function if you need per-chat scoping.
service firebase.storage {
  match /b/{bucket}/o {

    match /profilePics/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      fileName == request.auth.uid + '.jpg';
    }

    match /groupPics/{fileName} {
      allow read, write: if request.auth != null;
    }

    match /chatMedia/{chatId}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
