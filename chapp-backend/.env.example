# Copy to .env and adjust. Never commit real secrets.

# MongoDB connection
MONGO_URI=mongodb://localhost:27017
DB_NAME=chapp

# JWT — generate a strong secret, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=43200

# Media storage (local filesystem for dev)
UPLOAD_DIR=uploads

# Absolute base URL the mobile app uses to reach this server.
# Android emulator -> http://10.0.2.2:8000
# iOS simulator   -> http://127.0.0.1:8000
# Real device     -> http://<your-LAN-ip>:8000
PUBLIC_BASE_URL=http://localhost:8000

# CORS (comma-separated, or * for dev)
CORS_ORIGINS=*
